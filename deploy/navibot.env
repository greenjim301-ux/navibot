# /etc/default/navibot —— navibot 后端的可调项, 都是环境变量覆盖代码里的默认值。
# 全部可选: 这个文件不存在, 或者某一行注释掉, 就用 backend/app/config.py 里的默认。

# 监听端口(前端也从这个端口出)
NAVIBOT_PORT=8000

# ---- ROS ----
# 后端跟 SCAN-Planner 在同一台机器上时不用改
#ROS_MASTER_URI=http://localhost:11311
#ROS_IP=127.0.0.1

# ---- 路径 ----
# 原始地图数据(每张图一个目录, 里面要有 3d_map/ 和 2d_map/)
#NAVIBOT_MAP_DATA_DIR=/home/cat/map-data
# 预处理产物(pgm/png/点云), 后端通过 /map/... 提供给前端
#NAVIBOT_MAP_ASSETS_DIR=/home/cat/navibot/web_assets/map
# 前端构建产物。目录不存在就不 host 前端, 只提供接口
#NAVIBOT_FRONTEND_DIST_DIR=/home/cat/navibot/frontend/dist
# 巡检路线 / 地图编辑区域(用户数据, 备份的话备份这两个)
#NAVIBOT_ROUTE_DATA_DIR=/home/cat/navibot/data/routes
#NAVIBOT_MAP_EDIT_DATA_DIR=/home/cat/navibot/data/map_edits

# ---- 虚拟障碍(把禁行区喂给 SCAN-Planner 的局部避障, 见 README)----
#NAVIBOT_VIRTUAL_OBSTACLE_ENABLED=1
#NAVIBOT_VIRTUAL_OBSTACLE_TOPIC=/navibot/virtual_obstacles
