# --- 依赖与构建产物 ---
node_modules/
frontend/dist/
.vite/
.playwright-mcp/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- 地图数据 ---
# mapdata/ 是用户放进来的原始 PCD (当前 ~118MB), web_assets/ 是预处理生成的
# 派生资产 —— 两者都能从源头重新得到, 不进版本库。
mapdata/
web_assets/

# --- 运行时状态 ---
# 根目录下的运行时数据(比如已删除的旧版地图 SQLite 落盘文件残留)。锚定成
# /data/ 而不是 data/, 不然会连 frontend/src/data/ 这种源码目录也一起忽略掉。
/data/

*.log

# 本地便签, 不进版本库
claude-session.txt
